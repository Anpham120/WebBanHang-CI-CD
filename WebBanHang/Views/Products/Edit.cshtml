@model Product
@{ ViewData["Title"] = "Sửa sản phẩm"; }
<div class="pagehead"><h1>Sửa sản phẩm #@Model.Id</h1><a asp-action="Index">← Quay lại</a></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="panel formpanel">
  <input asp-for="Id" type="hidden" />
  <label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name" class="validation"></span>
  <label asp-for="CategoryId"></label><select asp-for="CategoryId" asp-items="ViewBag.Categories"><option value="0">-- Chọn danh mục --</option></select><span asp-validation-for="CategoryId" class="validation"></span>
  <label asp-for="Price"></label><input asp-for="Price" type="number" step="1" min="0" /><span asp-validation-for="Price" class="validation"></span>
  <label asp-for="Stock"></label><input asp-for="Stock" type="number" min="0" /><span asp-validation-for="Stock" class="validation"></span>
  <div class="actions"><button type="submit" class="button">Cập nhật sản phẩm</button></div>
</form>
